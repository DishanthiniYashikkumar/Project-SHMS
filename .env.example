# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.

# Base URL of the SHMS REST API. The login call posts to `${VITE_API_BASE_URL}/auth/login`.
VITE_API_BASE_URL=http://localhost:8080/api

# Set to "false" once the backend is running to hit the real endpoint.
# Any other value (or omitting this) keeps the in-browser mock login.
VITE_USE_MOCK_AUTH=true
