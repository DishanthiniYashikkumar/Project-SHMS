# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.

# Base URL of the Ocean Stays REST API (NestJS).
# Auth posts to `${VITE_API_BASE_URL}/auth/login`; every other service builds
# its paths from the same base — see src/services/apiClient.js.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Authentication mock. Set to "false" once /auth/login exists.
# Any other value (or omitting this) keeps the in-browser mock login.
VITE_USE_MOCK_AUTH=false

# Data mock for every other service (rooms, bookings, payments, requests...).
# Set to "false" once the corresponding NestJS endpoints are live.
# These two flags are independent, so auth can go real before the rest.
VITE_USE_MOCK_API=false
